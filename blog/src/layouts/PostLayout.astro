---
import SeoHead from '../components/SeoHead.astro';
import '../styles/article.css';

interface Props {
  title: string;
  description: string;
  path: string;
  topRight?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
}
const { title, description, path, topRight, ogType, jsonLd } = Astro.props;

// The SPA root sits outside this project's own base (astro.config.mjs sets
// base to /personal-portfolio/blog); hardcoded here for the same reason
// astro.config.mjs and the root vite.config.ts each hardcode their own base
// independently — the two projects are deliberately decoupled.
const spaRootHref = '/personal-portfolio/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b0b0c" />
    <SeoHead title={`${title} — Reza Gholizadeh`} description={description} ogType={ogType} jsonLd={jsonLd} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='18' fill='%230b0b0c'/%3E%3Ctext x='50' y='68' font-size='58' font-family='monospace' fill='%23fbbf24' text-anchor='middle'%3E%3E_%3C/text%3E%3C/svg%3E"
    />
  </head>
  <body>
    <div class="article">
      <header class="article__bar">
        <a class="article__back" href={spaRootHref}>← cd ~</a>
        <span class="article__path">{path}</span>
        {topRight && <span class="article__time">{topRight}</span>}
      </header>
      <article class="article__body">
        <slot />
      </article>
    </div>
  </body>
</html>
