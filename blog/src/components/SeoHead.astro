---
interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  /** One or more JSON-LD documents (e.g. BlogPosting + BreadcrumbList) — each
      renders as its own <script> tag, which Google treats the same as a
      single combined document. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const { title, description, ogType = 'website', jsonLd } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const jsonLdDocs = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL} />
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{jsonLdDocs.map((doc) => <script type="application/ld+json" is:inline set:html={JSON.stringify(doc)} />)}
